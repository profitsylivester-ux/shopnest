generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  TRASHED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  name         String
  role         Role       @default(BUYER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  store        Store?
  tokenVersion Int        @default(0)
  googleId     String?    @unique
  auditLogs    AuditLog[]
  reviews      Review[]
}

model Store {
  id                        String             @id @default(uuid())
  name                      String
  slug                      String             @unique @default(uuid())
  description               String?
  whatsappNumber            String?
  logoUrl                   String?
  bannerUrl                 String?
  location                  String?
  shopType                  String?
  instagramUrl              String?
  facebookUrl               String?
  tiktokUrl                 String?
  openingHours              String?
  deliveryReturns           String?
  announcement              String?
  isPaused                  Boolean            @default(false)
  status                    StoreStatus        @default(PENDING)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  ownerId                   String             @unique
  owner                     User               @relation(fields: [ownerId], references: [id])
  products                  Product[]
  events                    StoreEvent[]
  slugHistory               StoreSlugHistory[]
  reviews                   Review[]
  verificationRevoked       Boolean            @default(false)
  verificationRevokedReason String?
  verificationRevokedAt     DateTime?
}

model Product {
  id            String        @id @default(uuid())
  name          String
  description   String?
  price         Float
  wasPrice      Float?
  imageUrl      String?
  status        ProductStatus @default(ACTIVE)
  stockQuantity Int           @default(1)
  category      String?
  condition     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  events        StoreEvent[]
}

enum EventType {
  SHOP_VIEW
  PRODUCT_VIEW
  WHATSAPP_CLICK
}

model StoreEvent {
  id        String    @id @default(uuid())
  type      EventType
  source    String?
  createdAt DateTime  @default(now())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  visitorId String?

  @@index([storeId, createdAt])
  @@index([productId])
  @@index([storeId, type, visitorId])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model StoreSlugHistory {
  id        String   @id @default(uuid())
  slug      String   @unique
  createdAt DateTime @default(now())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  actorRole String
  action    String
  summary   String
  details   Json?
  ip        String?
  userAgent String?

  @@index([userId, createdAt])
}

model Category {
  id        String   @id @default(uuid())
  nameEn    String   @unique
  nameSw    String?
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String    @id @default(uuid())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum MenuLocation {
  NAVBAR
  FOOTER
}

model MenuItem {
  id        String       @id @default(uuid())
  labelEn   String
  labelSw   String?
  href      String
  location  MenuLocation @default(NAVBAR)
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  parentId  String?
  parent    MenuItem?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[]   @relation("MenuTree")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([location, sortOrder])
}

model SitePage {
  id          String   @id @default(uuid())
  slug        String   @unique
  titleEn     String
  titleSw     String?
  bodyEn      String
  bodySw      String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ReviewStatus {
  VISIBLE
  PENDING
  HIDDEN
}

model Review {
  id        String       @id @default(uuid())
  rating    Int
  comment   String?
  status    ReviewStatus @default(VISIBLE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([storeId, status])
  @@index([status, createdAt])
}

// Pictures kept inside the database (used on the live server when no cloud bucket is set up).
// The name is the same random file name used in /uploads/<name>.
model Picture {
  name        String   @id
  data        Bytes
  contentType String   @default("image/webp")
  createdAt   DateTime @default(now())
}
