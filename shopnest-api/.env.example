# ShopNest API settings. Copy this file to .env on your computer, or enter the same names in the host's
# Environment page (Render). Never commit the real .env and never share these values.

# --- always needed ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET=use-a-long-random-text-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- needed on the live server (NODE_ENV=production) ---
NODE_ENV=production
# The website address that may call this API (several can be separated by commas, no trailing slash).
FRONTEND_ORIGINS=https://your-website.onrender.com
# How many proxies stand in front of the API. A host such as Render is 1. On your computer leave it out (0).
TRUST_PROXY=1

# --- optional ---
# PORT=3001                 (Render sets this by itself)
# JSON_LIMIT=2mb            (biggest JSON body the API accepts)
# RATE_LIMIT_PER_MIN=600    (requests one visitor address may make per minute)

# --- picture storage in the cloud (Cloudflare R2, Backblaze B2 or another S3-style bucket) ---
# Set ALL FIVE or none. With none, pictures are kept in the uploads folder on the same computer.
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=shopnest-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# S3_REGION=auto
